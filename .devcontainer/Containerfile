# Dev Container image for Protoctist.jl
# Base: Chainguard Wolfi (minimal, supply-chain-secure)
# Build: podman build -t Protoctist.jl-dev -f .devcontainer/Containerfile .
# `:latest` suits a dev container (rebuilt daily); pin by digest
# (...@sha256:<digest>) if you need a reproducible dev environment.

FROM cgr.dev/chainguard/wolfi-base:latest

# Install common development tools, then create the non-root dev user
# (matches devcontainer.json remoteUser).
RUN apk update && apk add --no-cache \
    bash \
    build-base \
    ca-certificates \
    curl \
    git \
    openssh-client \
    posix-libc-utils \
    shadow \
    && rm -rf /var/cache/apk/* \
    && (groupadd -g 1000 nonroot || true) \
    && (useradd -m -u 1000 -g 1000 -s /bin/bash nonroot || true)

# Set workspace directory
WORKDIR /workspaces/Protoctist.jl

# Default shell
ENV SHELL=/bin/bash

USER nonroot
