# SPDX-License-Identifier: MPL-2.0
# ECOSYSTEM.a2ml: where Protoctist.jl sits in the estate.
#
# Written anew on 2026-11-12 from Project.toml, README.adoc,
# docs/EXPLAINME.adoc and VARIANT.a2ml. It replaces the template's own
# ECOSYSTEM, which this repository carried from its mint. Planned to move into
# the repo deed with the other descriptiles.

[metadata]
project = "Protoctist.jl"
ecosystem = "hyperpolymath"

[position]
type = "julia-library"
purpose = "Integration library unifying types, IO and exports for PR2/SILVA-driven protist workflows"
# IS-NOT: anti-identity (the boundary-erosion guard)
what-this-is-not = [
  "rsr-template-repo (the template this repository was minted from; its ECOSYSTEM, STATE and CHANGELOG were carried here by mistake)",
  "a classifier (it consumes assignments from DADA2, QIIME 2 and others; it does not produce them)",
  "a phylogeny tool (the exported tree is the taxonomy the lineages span, with ranks and no branch lengths)",
  "a PR2-to-SILVA mapper (it refuses to mix the two ladders)",
  "EpistemicTypes.jl (it carries receipts but never mints or verifies them, and its Standpoint, Warrant and ProjectionY are separate types with different fields)",
]

[pipeline]
position = "library"
chain = "DADA2 / QIIME 2 / EPA-ng outputs → Protoctist.jl (lineages, rollup, jplace, manifests) → Newick and iTOL datasets"
notes = "No package dependencies. Package extensions for EpistemicTypes.jl and Cladistics.jl are planned; none ships in 0.1."
# Not assigned yet: CLADE.a2ml has clade primary = "UNASSIGNED".
coordination = ""

[related-projects]
projects = [
  { name = "EpistemicTypes.jl", relationship = "planned-extension", notes = "Receipts, epi_status and the merge check in general form. Shares type names with different fields; one package must own them before the extension." },
  { name = "Cladistics.jl", relationship = "planned-extension", notes = "General tree algebra and LCA; the extension would convert a TaxonomyTree to a Cladistics tree." },
  { name = "EchoTypes.jl", relationship = "sibling", notes = "Executable companion to the Agda library echo-types." },
  { name = "rsr-template-repo", relationship = "minted-from", notes = "Template parent recorded in VARIANT.a2ml; supplies the CI, governance and machine-readable scaffolding." },
]
