#
# STATE.a2ml: project state checkpoint for Protoctist.jl.
#
# Derived on 2026-11-12 from CLADE.a2ml ([status] phase = "incubating"),
# Project.toml (version, description) and docs/status/ROADMAP.adoc. It
# replaces the template's own STATE, which this repository carried from its
# mint.

[metadata]
project = "Protoctist.jl"
version = "0.1.0"
last-updated = "2026-11-12"
# status: active | paused | archived | planned
#   planned: the repo is RESERVED but has not started (minted as a placeholder;
#            equivalent to CLADE [status] phase = "reserved"). It is NOT
#            "paused": paused reads as "was active, stopped".
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it; never
# hand-edit both into agreement (standards#726).
# CLADE phase "incubating" has code under active work, so it maps to "active".
status = "active"

[project-context]
name = "Protoctist.jl"
purpose = "Integration library unifying types, IO and exports for PR2/SILVA-driven protist workflows"
# The share of [route-to-mvp] milestones that are complete (6 of 12).
completion-percentage = 50

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
# The 0.1.0 items and the next-release candidates in docs/status/ROADMAP.adoc.
milestones = [
  { name = "Ladder-typed lineages (PR2, SILVA) with unfilled ranks kept in place", completion = 100 },
  { name = "Taxonomy tree, count and evidence rollup, and clade cumulus", completion = 100 },
  { name = "Lineage tables in CSV, TSV and ECSV", completion = 100 },
  { name = "jplace reading and writing with every placement kept", completion = 100 },
  { name = "Newick/NHX and iTOL dataset export", completion = 100 },
  { name = "Run manifests and a merge check over the judgement surface", completion = 100 },
  { name = "Package extensions for EpistemicTypes.jl and Cladistics.jl", completion = 0 },
  { name = "QIIME 2 rank prefixes and literal NA as unfilled ranks", completion = 0 },
  { name = "Per-row attribution report", completion = 0 },
  { name = "jplace fidelity: nm multiplicities and the metadata block", completion = 0 },
  { name = "iTOL label collisions detected", completion = 0 },
  { name = "Register in the Julia General registry", completion = 0 },
]

[blockers-and-issues]
# 1. EpistemicTypes.jl defines Standpoint, Warrant and ProjectionY with the
#    same names as this package but different fields, so the planned
#    extension cannot alias them. One package must own the vocabulary first.

[critical-next-actions]
actions = [
  "Decide which package owns Standpoint, Warrant and ProjectionY (this one or EpistemicTypes.jl)",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
# Related, not parent: EpistemicTypes.jl, Cladistics.jl and EchoTypes.jl
# (see README.adoc).
part-of = []
depends-on = []
