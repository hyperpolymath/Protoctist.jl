# rsr-profile.a2ml — this repo's declared RSR v2.0 capabilities.
# Generated by just repo-init on 2026-09-23. The template's maximal
# profile was removed at mint: declare only what this tree carries.

[rsr-profile]
version = "1.0.0"
spec = "rsr-criteria-v2"
declares-against = "2.0.0-draft"
preset = "julia-library"

# The canon<->repo binding: these three pins are compared against
# hyperpolymath/standards' canon.lock by the Dogfood Gate's Canon lockstep
# job (dogfood-gate.yml, Job 6). A pin nothing verifies is not a binding,
# so the block was absent only while the job was red; the values are read
# from metadatastician/standards canon.lock at 2.1.3. The gate-table
# correction leaves the criteria hash unchanged. This records the adopted
# identity; broader applicability findings are tracked in bot_directives/debt.a2ml.
[canon]
version = "2.1.3"
criteria_sha256 = "6a5aa8857bd0d0d58ef48827938ca17c251b6b854dacf59d306388d61694d82a"
gates_sha256 = "2f31f46d4753432e0aa8c9c28f339e18e062c98dc6e6ef4ecbb76993cf37638b"
